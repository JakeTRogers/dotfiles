#!/bin/sh
# Verify a Minimal mode install, as the Install Smoke Test does. Run it as
# `sh bin/smoke_verify` from the checkout, in the container that ran ./install.sh.
set -e

test -L "$HOME/.zshrc"
test -d "$HOME/.oh-my-zsh"
command -v zsh || { echo "missing: zsh"; exit 1; }
# getRelease and the Tools it installs belong in ~/.local/bin
for c in getRelease bat fd fzf rg; do
  test -x "$HOME/.local/bin/$c" || { echo "missing from ~/.local/bin: $c"; exit 1; }
done
TERM=xterm-256color zsh -ic 'echo SMOKE_OK' | grep -q SMOKE_OK
if command -v tmux; then echo "Minimal mode installed tmux"; exit 1; fi
zsh_stderr="$(TERM=xterm-256color zsh -ic exit 2>&1 > /dev/null)"
if printf '%s\n' "$zsh_stderr" | grep -i tmux; then echo "zsh startup warned about tmux"; exit 1; fi
# Minimal mode has no nvim, so Git must open vim rather than a missing editor
TERM=xterm-256color zsh -ic 'echo "GIT_EDITOR=$(git var GIT_EDITOR)"' | grep -x 'GIT_EDITOR=vim'
# agents links one instruction file to each agent's user-level instruction file
for f in "$HOME/.claude/CLAUDE.md" "$HOME/.copilot/copilot-instructions.md"; do
  if [ ! -L "$f" ] || [ ! -f "$f" ]; then echo "missing agents instructions link: $f"; exit 1; fi
done
# agents merges Claude Code's worktree hooks into its user settings
command -v jq || { echo "missing: jq"; exit 1; }
jq -e '(.hooks.WorktreeCreate | length) == 1 and (.hooks.WorktreeRemove | length) == 1' \
  "$HOME/.claude/settings.json" || { echo "worktree hooks missing from ~/.claude/settings.json"; exit 1; }
