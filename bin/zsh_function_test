#!/usr/bin/env zsh
# Correctness checks for omz/functions that `zsh -n` cannot reach.
#
# bin/zsh_syntax_check only parses; every bug this catches parses fine. Three
# checks, cheapest first:
#
#   1. leaks  — autoloaded functions run in the caller's scope, so any name they
#               forget to declare becomes a global that outlives the command.
#               Snapshot the namespace, run the function, diff.
#   2. lint   — source patterns that are always wrong, e.g. splitting a command
#               substitution with (@f) and then testing the array for emptiness:
#               empty output yields one empty element, not an empty array.
#   3. units  — behaviour of the pieces with logic worth pinning down, driven
#               through stubbed kubectl/git rather than a live cluster.
#
# Usage: zsh_function_test [FILE...]
#
# With no arguments every function is checked. With arguments — which is how
# pre-commit calls it — the per-function checks are limited to the files named,
# because spawning a fresh shell per function to diff its namespace costs a few
# seconds each and a full sweep is too slow for a commit hook. The unit checks
# always run; they cover shared helpers, history completions, Git pickers and
# the editor zshrc chooses.

emulate -L zsh
setopt no_nomatch pipe_fail

local repo
repo="$(git rev-parse --show-toplevel 2>/dev/null)" || repo="$PWD"

# A hook run in a linked worktree inherits GIT_DIR and GIT_INDEX_FILE, which
# `git -C` does not override, so every fixture below would write its commits,
# tags, branch renames and config into the repo being committed to. Only $repo
# is needed from it, so drop git's repository-local variables now.
unset ${(f)"$(git rev-parse --local-env-vars)"}

local functions_dir="$repo/omz/functions"
if [[ ! -d "$functions_dir" ]]; then
  print -u2 -- "🔴 zsh_function_test: not a dotfiles checkout: missing $functions_dir"
  exit 2
fi

# Restrict the per-function checks to the files named on the command line.
local -a targets
local arg
for arg in "$@"; do
  [[ "${arg:A:h}" == "${functions_dir:A}" && -f "$arg" ]] && targets+=("${arg:A}")
done
if (( $# == 0 )); then
  targets=("$functions_dir"/*(.N))
elif (( ${#targets} == 0 )); then
  # Called with files, none of which are functions: nothing per-function to do.
  targets=()
fi

# These ignore their arguments and act immediately, so "$fn --help" RUNS them.
# gundo is `git reset --soft HEAD~1`; grias and gresign start a rebase. Never invoke them.
local -a never_invoke=(gundo czbnt gciaf gcif gdu gdus grias gresign)

integer failures=0
fail() { print -r -- "  🔴 $*"; (( failures++ )) }
pass() { print -r -- "  ✅ $*" }

# Functions are run from a scratch directory, never the checkout. Several of
# them reach for git, and running those against the real repository is both
# slow (signing, hooks) and a hazard — an earlier version of this harness ran
# `gundo --help`, which is `git reset --soft HEAD~1` and ignores its arguments.
# Cleaned up explicitly at the end rather than with an EXIT trap: zsh runs an
# EXIT trap when a *subshell* exits too, and every check below runs in one.
local scratch="$(mktemp -d)"
trap 'rm -rf -- "$scratch"; exit 130' INT TERM

# Run a snippet in a pristine zsh with the functions autoloadable and the
# colour variables from variables.zsh stubbed empty, so output stays plain.
# Set TESTCWD to run somewhere other than the scratch directory.
#
# stdin comes from /dev/null: the filter functions (_cheat_render, _cheat_fzf)
# read their input from stdin, so invoking them with an inherited terminal makes
# them block forever rather than fail.
_isolated() {
  local snippet="$1"; shift
  ( cd -- "${TESTCWD:-$scratch}" || return 1
  zsh -f -c '
    fdir=$1; snippet=$2; shift 2
    fpath=($fdir $fpath)
    for v in fgBlack fgRed fgGreen fgYellow fgBlue fgMagenta fgCyan fgWhite \
             fgPurple fgPink fgOrange fgDkGrey fgGrey fgLtGrey \
             bgRed bgGreen bgYellow bgBlue \
             txBold txHalf txUnderline txReverse txStandout txReset; do
      typeset -g $v=""
    done
    typeset -g _FP_CONTAINER_FORMAT=$'"'"'{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'"'"'
    typeset -g _FP_IMAGE_FORMAT=$'"'"'{{.ID}}\t{{.Repository}}:{{.Tag}}\t{{.CreatedSince}}\t{{.Size}}'"'"'
    local fn
    for fn in $(ls -- "$fdir"); do autoload -Uz -- "$fn"; done
    eval "$snippet"
  ' zsh "$functions_dir" "$snippet" "$@" < /dev/null )
}

# --- 1. Leaked globals -------------------------------------------------------
print "── leaked globals ──"

# name:snippet pairs that reach past the --help guard into the real code path.
# Anything not listed here is exercised with --help, which is enough for the
# functions whose locals are declared before the guard.
local -a leak_cases
leak_cases=(
  'decode_jwt|h=$(printf %s "{\"alg\":\"none\"}" | base64 -w0 | tr "+/" "-_" | tr -d "=");
              p=$(printf %s "{\"sub\":\"x\"}" | base64 -w0 | tr "+/" "-_" | tr -d "=");
              decode_jwt --raw "$h.$p.AAAA"'
  'get_k8s_images|get_k8s_images --kind app,init a-namespace a-context'
  'decode_cert|decode_cert /nonexistent.pem'
  'copipe|print x | copipe --preset explain --allow-tool shell --show-prompt'
  'k8|k8 flapping -n somewhere'
  '_fp_pick|_fp_pick --source ps --binds reload,logs --query x'
)

# Names the shell itself updates on any command, plus the harness's own.
local ignore_re='^(__before|__after|fdir|snippet|fn|v|h|p|RANDOM|SECONDS|LINENO|EPOCHSECONDS|EPOCHREALTIME|HISTCMD|OLDPWD|COLUMNS|LINES|status|pipestatus|_|\?|argv|ZSH_SUBSHELL|TTYIDLE|zle_bracketed_paste)$'

# _update_omz_repo is deliberately dynamically scoped: its docstring states that
# it increments update_omz_all's total/updated/skipped counters, which is what
# makes it a helper for that function rather than a standalone command.
local -a leak_exempt=(_update_omz_repo)

_leak_diff() {  # $1 = snippet
  _isolated '
    __before=$(typeset +g | sort)
    { '"$1"' } >/dev/null 2>&1
    __after=$(typeset +g | sort)
    comm -13 <(print -r -- "$__before") <(print -r -- "$__after") |
      sed "s/=.*//; s/'"'"'//g" | awk "{print \$NF}" | sort -u
  ' 2>/dev/null | grep -vE "$ignore_re"
}

local entry name snippet out fn
for entry in "${leak_cases[@]}"; do
  name="${entry%%|*}"
  snippet="${entry#*|}"
  [[ -f "$functions_dir/$name" ]] || continue
  (( ${targets[(I)$functions_dir/$name]} )) || continue
  out="$(_leak_diff "$snippet")"
  [[ -n "$out" ]] && fail "$name leaks: ${(j:, :)${(f)out}}"
done

for fn in "${targets[@]}"; do
  name="${fn:t}"
  [[ " ${never_invoke[*]} " == *" $name "* ]] && continue
  [[ " ${leak_exempt[*]} " == *" $name "* ]] && continue
  out="$(_leak_diff "$name --help")"
  [[ -n "$out" ]] && fail "$name --help leaks: ${(j:, :)${(f)out}}"
done
(( failures == 0 )) && pass "no function leaves globals behind"

# --- 2. Source lint ----------------------------------------------------------
print "── source lint ──"
integer lint_failures=$failures

# ${(@f)$(cmd)} on empty output yields ONE empty element, so a following
# ${#arr} test passes and the caller runs with an empty argument. Every use
# must be followed by an ":#" strip. This is the fpl/fpst bug.
local file line_no
for fn in "${targets[@]}"; do
  grep -n '(@f)\$(' -- "$fn" 2>/dev/null | while IFS=: read -r line_no _; do
    # the strip may be on the same line or within the next few
    if ! sed -n "${line_no},$((line_no + 6))p" -- "$fn" | grep -q ':#}'; then
      fail "${fn:t}:${line_no} splits with (@f) but never strips the empty element"
    fi
  done
done

# emulate -L zsh keeps interactive options (nullglob, extendedglob, ksharrays,
# shwordsplit) from changing how a function behaves. The one-line passthroughs
# have no shell logic to protect and are exempt; keep this list in step with
# the one in omz/README.md.
local -a passthroughs=(gdu gdus gciaf gcif gundo)
for fn in "${targets[@]}"; do
  name="${fn:t}"
  [[ " ${passthroughs[*]} " == *" $name "* ]] && continue
  grep -q 'emulate -L zsh' -- "$fn" || fail "${name} has no 'emulate -L zsh'"
done

# [[ =~ ]] writes MATCH/MBEGIN/MEND into the enclosing scope unless declared local
for fn in "${targets[@]}"; do
  name="${fn:t}"
  grep -q '=~' -- "$fn" || continue
  grep -q 'local.*\bMATCH\b' -- "$fn" || fail "${name} uses =~ without 'local MATCH MBEGIN MEND'"
done
(( failures == lint_failures )) && pass "no lint violations"

# --- 3. Unit checks ----------------------------------------------------------
print "── units ──"
integer unit_failures=$failures

expect() {  # expect <label> <expected> <actual>
  if [[ "$2" == "$3" ]]; then
    pass "$1"
  else
    fail "$1"
    print -r -- "       expected: $2"
    print -r -- "       actual:   $3"
  fi
}

# _decode_base64_url: base64url alphabet and stripped padding
local encoded decoded
encoded="$(printf '%s' '{"a":"?~>"}' | base64 -w0 | tr '+/' '-_' | tr -d '=')"
decoded="$(_isolated "_decode_base64_url ${(q)encoded}")"
expect "_decode_base64_url round-trips base64url" '{"a":"?~>"}' "$decoded"

# get_k8s_images: a registry port must not be mistaken for a tag separator
local stub_bin="$(mktemp -d)" fixture="$(mktemp -d)"
{
  print -r -- '#!/bin/sh'
  print -r -- "cat $fixture/pods.json"
} > "$stub_bin/kubectl"
chmod +x "$stub_bin/kubectl"
cat > "$fixture/pods.json" <<'JSON'
{"items":[{"metadata":{"namespace":"ns"},"spec":{"containers":[
  {"image":"registry.io:5000/team/app"},
  {"image":"registry.io:5000/team/app:v3"},
  {"image":"nginx:1.2"},
  {"image":"nginx"}
]}}]}
JSON
local images
images="$(PATH="$stub_bin:$PATH" _isolated 'get_k8s_images --kind app ns ctx' | tail -n +2 | awk '{print $2"|"$3}' | sort | tr '\n' ' ')"
expect "get_k8s_images splits image and tag" \
  'nginx|(none) nginx|1.2 registry.io:5000/team/app|(none) registry.io:5000/team/app|v3 ' \
  "$images"
rm -rf "$stub_bin" "$fixture"

# Minimal mode does not install gh or cz, so the functions that need them must
# say so rather than fail with a bare command-not-found. An empty path leaves
# every external program absent.
local missing
missing="$(_isolated 'path=(); git_pr_check; print -r -- "rc=$?"' 2>&1)"
expect "git_pr_check reports a missing gh" \
  $'🔴 gh is required, but not found.\nrc=1' "$missing"
missing="$(_isolated 'path=(); czbnt; print -r -- "rc=$?"' 2>&1)"
expect "czbnt reports a missing cz" \
  $'🔴 cz is required, but not found.\nrc=1' "$missing"

# git_find_branch_base: origin/HEAD wins, and the remote-tracking ref is
# preferred over a stale local trunk
local sandbox="$(mktemp -d)" setup_log="$(mktemp)"
(
  # The ambient global config is bypassed so commit signing cannot block this,
  # which also means init.defaultBranch is unset: name every branch explicitly.
  export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
  set -e
  git init -q --bare -b main "$sandbox/up.git"
  git clone -q "$sandbox/up.git" "$sandbox/w"
  cd "$sandbox/w" || exit 1
  git config user.email t@t; git config user.name t; git config commit.gpgsign false
  git checkout -q -b main
  print 1 > f; git add -A; git commit -qm C1
  print 2 >> f; git add -A; git commit -qm C2
  git push -q -u origin main
  git remote set-head origin main
  git checkout -qb feat
  print 3 >> f; git add -A; git commit -qm C3
  git branch -f main HEAD~2        # leave the local trunk behind at C1
) >"$setup_log" 2>&1 || {
  fail "git_find_branch_base fixture setup failed"
  sed 's/^/       /' "$setup_log"
}
local base_name base_hash expected_hash
base_name="$(TESTCWD="$sandbox/w" _isolated 'git_find_branch_base -n')"
base_hash="$(TESTCWD="$sandbox/w" _isolated 'git_find_branch_base')"
expected_hash="$(git -C "$sandbox/w" rev-parse origin/main)"
expect "git_find_branch_base prefers origin/HEAD's branch" 'origin/main' "$base_name"
expect "git_find_branch_base ignores a stale local trunk" "$expected_hash" "$base_hash"

# _gcfuh_blame_target: blame only the lines the diff actually removes, and
# return the newest on-branch commit among them
(
  cd "$sandbox/w" || exit 1
  printf 'a\nb\nc\n' > blame.txt
  git add -A; git commit -qm "add blame.txt"
  printf 'a\nB\nc\n' > blame.txt          # modify line 2, committed by the above
) >/dev/null 2>&1
local blame_out expected_blame
expected_blame="$(git -C "$sandbox/w" log -1 --format='%h %s' -- blame.txt)"
blame_out="$(TESTCWD="$sandbox/w" _isolated 'boundary=$(git_find_branch_base); _gcfuh_blame_target blame.txt "$boundary"')"
expect "_gcfuh_blame_target picks the commit that owns the changed line" \
  "$expected_blame" "$blame_out"

# pure additions have no committed lines to blame, so nothing is suggested
(
  cd "$sandbox/w" || exit 1
  git checkout -q -- blame.txt
  printf 'a\nb\nc\nd\n' > blame.txt       # append only
) >/dev/null 2>&1
blame_out="$(TESTCWD="$sandbox/w" _isolated 'boundary=$(git_find_branch_base); _gcfuh_blame_target blame.txt "$boundary"')"
expect "_gcfuh_blame_target suggests nothing for a pure addition" '' "$blame_out"

# _gcfuh_base: on a feature branch the fixup scope is the branch base
base_name="$(TESTCWD="$sandbox/w" _isolated '_gcfuh_base -n')"
base_hash="$(TESTCWD="$sandbox/w" _isolated '_gcfuh_base')"
expect "_gcfuh_base uses the branch base on a feature branch" \
  "origin/main $expected_hash" "$base_name $base_hash"

# gciaf and gcif complete the fixup scope through _commits_since_merge. No
# message or description format style is set in this config, and without one
# zsh's _message displays only a raw (-r) message, so the stub prints only those.
local fixup_probe='
  fpath=("${fdir:h}/completions" $fpath)
  autoload -Uz _gciaf _gcif _commits_since_merge
  _arguments() { _commits_since_merge }
  _describe() {
    [[ "$1" == -V ]] || { print -r -- "sorted completion"; return 1; }
    print -rl -- "${(@P)argv[-1]}"
  }
  _message() { [[ "$1" == -r ]] && print -r -- "message: $2" }'
local fixup_completion fixup_out expected_candidates
_fixture_git() {  # git as in a fixture's setup: no ambient config, output to its log
  GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null git "$@" >>"$setup_log" 2>&1
}
_fixture_git -C "$sandbox/w" commit -q --allow-empty -m "fixup! C3"
expected_candidates="$(git -C "$sandbox/w" rev-parse --short HEAD~1):add blame.txt"$'\n'
expected_candidates+="$(git -C "$sandbox/w" rev-parse --short HEAD~2):C3"
for fixup_completion in _gciaf _gcif; do
  fixup_out="$(TESTCWD="$sandbox/w" _isolated "$fixup_probe; $fixup_completion")"
  expect "${fixup_completion#_} completes feature branch commits newest first, fixups excluded" \
    "$expected_candidates" "$fixup_out"
done
rm -rf "$sandbox" "$setup_log"

# The default branch itself: the merge base is HEAD, so the scope falls back to
# the whole history until the first tag, then to everything after the newest tag
sandbox="$(mktemp -d)" setup_log="$(mktemp)"
(
  export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
  set -e
  git init -q -b main "$sandbox/w"
  cd "$sandbox/w" || exit 1
  git config user.email t@t; git config user.name t; git config commit.gpgsign false
  printf 'a1\na2\na3\n' > a.txt; git add -A; git commit -qm "feat: add a"
  printf 'b1\nb2\n' > b.txt;     git add -A; git commit -qm "feat: add b"
  printf 'a1\na2\nA3\n' > a.txt; git add -A; git commit -qm "feat: extend a"
  # a.txt: lines from the root commit and the newest one; b.txt: one owner
  printf 'X1\na2\nX3\n' > a.txt
  printf 'b1\nB2\n' > b.txt
  print new > new.txt
) >"$setup_log" 2>&1 || {
  fail "gcfuh default-branch fixture setup failed"
  sed 's/^/       /' "$setup_log"
}
local c1 c2 c3
c1="$(git -C "$sandbox/w" rev-parse --short HEAD~2)"
c2="$(git -C "$sandbox/w" rev-parse --short HEAD~1)"
c3="$(git -C "$sandbox/w" rev-parse --short HEAD)"

base_name="$(TESTCWD="$sandbox/w" _isolated '_gcfuh_base -n')"
base_hash="$(TESTCWD="$sandbox/w" _isolated '_gcfuh_base')"
expect "_gcfuh_base puts the whole history in scope on an untagged default branch" \
  ' ' "$base_name $base_hash"

blame_out="$(TESTCWD="$sandbox/w" _isolated '_gcfuh_blame_target a.txt ""' | cut -d' ' -f1 | tr '\n' ' ')"
expect "_gcfuh_blame_target lists every blamed commit newest first, root included" \
  "$c3 $c1 " "$blame_out"

# gcfuh -a places only what is unambiguous; stdin is /dev/null, so the
# confirmation reads nothing and no commit is made. Reduce the plan to
# "section:file" pairs, where a section is a target hash, split or unassigned.
local gcfuh_stubs='_fzf_git_check() { git rev-parse --git-dir >/dev/null 2>&1 }
  _fzf_git_fzf() { cat >/dev/null }
  fzf() { : }'
local plan
plan="$(TESTCWD="$sandbox/w" _isolated "$gcfuh_stubs; gcfuh -a" 2>&1 |
  awk '/^  [0-9a-f]+: /{s=substr($1, 1, length($1) - 1)}
       /^  Split:/{s="split"} /^  Unassigned:/{s="unassigned"}
       /^    /{printf "%s:%s ", s, $1}')"
expect "gcfuh -a assigns single-owner files and leaves split and new files" \
  "$c2:b.txt split:a.txt unassigned:new.txt " "$plan"
expect "gcfuh -a commits nothing without confirmation" \
  "$c3" "$(git -C "$sandbox/w" rev-parse --short HEAD)"

expect "gcfuh -a leaves no globals behind" '' \
  "$(TESTCWD="$sandbox/w" _leak_diff "$gcfuh_stubs; gcfuh -a")"
expect "gcfuh commit-first mode leaves no globals behind" '' \
  "$(TESTCWD="$sandbox/w" _leak_diff "$gcfuh_stubs; gcfuh")"

local picker_probe='
  _fzf_git_fzf() {
    cat >/dev/null
    if (( ${argv[(Ie)--no-sort]} )); then
      print -r -- "picker-order=preserved" >&2
    else
      print -r -- "picker-order=sorted" >&2
    fi
  }'
local picker_command
for picker_command in 'gcfuh' 'gcfuh a.txt'; do
  expect "$picker_command preserves target order while filtering" 'picker-order=preserved' \
    "$(TESTCWD="$sandbox/w" _isolated "$gcfuh_stubs; $picker_probe; $picker_command" 2>&1 |
       grep '^picker-order=')"
done
for picker_command in _fzf_git_stashes _fzf_git_lreflogs; do
  expect "$picker_command preserves history order while filtering" 'picker-order=preserved' \
    "$(TESTCWD="$sandbox/w" _isolated '
       source "${fdir:h:h}/fzf/fzf-git.sh" --run
       '"$picker_probe"'
       '"$picker_command" 2>&1 | grep '^picker-order=')"
done

# once released, only the commits after the newest tag are in scope
git -C "$sandbox/w" tag v0.1.0 HEAD~1
base_name="$(TESTCWD="$sandbox/w" _isolated '_gcfuh_base -n')"
base_hash="$(TESTCWD="$sandbox/w" _isolated '_gcfuh_base')"
expect "_gcfuh_base stops at the newest tag on the default branch" \
  "v0.1.0 $(git -C "$sandbox/w" rev-parse HEAD~1)" "$base_name $base_hash"

# with HEAD itself released the scope is empty, which must not look broken
_fixture_git -C "$sandbox/w" tag v0.2.0 HEAD
for fixup_completion in _gciaf _gcif; do
  fixup_out="$(TESTCWD="$sandbox/w" _isolated "$fixup_probe; $fixup_completion")"
  expect "${fixup_completion#_} explains an empty scope on a released HEAD" \
    'message: no commits after v0.2.0 to fix up' "$fixup_out"
done
git -C "$sandbox/w" tag -d v0.2.0 >/dev/null
git -C "$sandbox/w" branch -m topic
base_name="$(TESTCWD="$sandbox/w" _isolated '_gcfuh_base -n')"
base_hash="$(TESTCWD="$sandbox/w" _isolated '_gcfuh_base')"
expect "_gcfuh_base includes the root when no default branch is discoverable" \
  ' ' "$base_name $base_hash"

# Exercise the real completion entry points without requiring a ZLE session.
git -C "$sandbox/w" branch main HEAD~2
local completion_probe='
  fpath=("${fdir:h}/completions" $fpath)
  autoload -Uz _ghist _git_tag_semver
  _arguments() { __git_tag_semver_commits }
  _describe() {
    [[ "$1" == -V ]] || { print -r -- "sorted completion"; return 1; }
    print -rl -- "${(@P)argv[-1]}"
  }'
local completion_out
completion_out="$(TESTCWD="$sandbox/w" _isolated "$completion_probe; _ghist" |
  grep '^HEAD' | cut -d: -f1)"
expect "ghist completes revisions in history order" $'HEAD\nHEAD~1' "$completion_out"
completion_out="$(TESTCWD="$sandbox/w" _isolated "$completion_probe; _git_tag_semver" |
  cut -d: -f1)"
expect "git_tag_semver completes HEAD and newest-first hashes on the first call" \
  $'HEAD\n'"$c3"$'\n'"$c2"$'\n'"$c1" "$completion_out"
rm -rf "$sandbox" "$setup_log"

# gresign: re-sign every commit after the branch base for real, with a throwaway
# SSH key, so no key of the user's is ever touched. The fixture is a feature
# branch of two unsigned commits on a pushed main, with one of them pushed too.
sandbox="$(mktemp -d)" setup_log="$(mktemp)"
(
  export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
  set -e
  ssh-keygen -q -t ed25519 -N '' -C t@t -f "$sandbox/key"
  print -r -- "t@t $(<"$sandbox/key.pub")" > "$sandbox/allowed_signers"
  git init -q --bare -b main "$sandbox/up.git"
  git clone -q "$sandbox/up.git" "$sandbox/w"
  cd "$sandbox/w" || exit 1
  git config user.email t@t; git config user.name t; git config commit.gpgsign false
  git config gpg.format ssh
  git config user.signingkey "$sandbox/key"
  git config gpg.ssh.allowedSignersFile "$sandbox/allowed_signers"
  git checkout -q -b main
  print 1 > f; git add -A; git commit -qm C1
  git push -q -u origin main
  git remote set-head origin main
  git checkout -qb feat
  print 2 >> f; git add -A; git commit -qm "C2" -m "body of C2"
  git push -q -u origin feat
  print 3 >> f; git add -A; git commit -qm C3
) >"$setup_log" 2>&1 || {
  fail "gresign fixture setup failed"
  sed 's/^/       /' "$setup_log"
}
_gresign_view() {  # signature, tree and message of each commit, oldest first
  git -C "$sandbox/w" log --reverse --format='%G? %T %s|%b' "$@" | tr '\n' ' '
}
local before resign_out resign_rc head_before
before="$(_gresign_view --format='%T %s|%b' origin/main..HEAD)"
print dirty >> "$sandbox/w/f"
resign_out="$(TESTCWD="$sandbox/w" _isolated 'gresign' 2>&1)"
resign_rc=$?
expect "gresign succeeds on a feature branch" 0 "$resign_rc"
expect "gresign signs every commit after the branch base" 'G G' \
  "$(git -C "$sandbox/w" log --reverse --format=%G? origin/main..HEAD | tr '\n' ' ' | sed 's/ $//')"
expect "gresign keeps each commit's tree and message" "$before" \
  "$(_gresign_view --format='%T %s|%b' origin/main..HEAD)"
expect "gresign leaves the branch base unsigned and in place" \
  "$(git -C "$sandbox/w" rev-parse origin/main)" "$(git -C "$sandbox/w" rev-parse HEAD~2)"
expect "gresign keeps uncommitted changes" $'1\n2\n3\ndirty' "$(<"$sandbox/w/f")"
expect "gresign reports how many commits it signed" 1 \
  "$(print -r -- "$resign_out" | grep -c 'Signed 2 commits')"
expect "gresign says a pushed branch needs a force-push" 1 \
  "$(print -r -- "$resign_out" | grep -c 'force-push')"

# gresign <ref>: only the commits after ref are rewritten. Strip the
# signatures from the whole branch first, so both sides of ref start unsigned.
_fixture_git -C "$sandbox/w" checkout -q -- f
_fixture_git -C "$sandbox/w" -c commit.gpgsign=false commit -q --allow-empty -m C4
_fixture_git -C "$sandbox/w" rebase -q --force-rebase --no-gpg-sign origin/main
head_before="$(git -C "$sandbox/w" rev-parse HEAD~1)"
resign_out="$(TESTCWD="$sandbox/w" _isolated 'gresign HEAD~1' 2>&1)"
expect "gresign <ref> signs only the commits after ref" 'N N G' \
  "$(git -C "$sandbox/w" log --reverse --format=%G? origin/main..HEAD | tr '\n' ' ' | sed 's/ $//')"
expect "gresign <ref> leaves ref itself in place" "$head_before" \
  "$(git -C "$sandbox/w" rev-parse HEAD~1)"
expect "gresign <ref> reports a count of one" 1 \
  "$(print -r -- "$resign_out" | grep -c 'Signed 1 commit\b')"

# a merge commit in the range: refuse, and leave the branch alone
_fixture_git -C "$sandbox/w" checkout -q -b side HEAD~1
_fixture_git -C "$sandbox/w" -c commit.gpgsign=false commit -q --allow-empty -m S1
_fixture_git -C "$sandbox/w" checkout -q feat
_fixture_git -C "$sandbox/w" -c commit.gpgsign=false merge -q --no-ff --no-edit side
head_before="$(git -C "$sandbox/w" rev-parse HEAD)"
resign_out="$(TESTCWD="$sandbox/w" _isolated 'gresign' 2>&1)"
resign_rc=$?
expect "gresign refuses a range with a merge commit" 1 "$resign_rc"
expect "gresign leaves a branch with a merge commit unchanged" \
  "$head_before" "$(git -C "$sandbox/w" rev-parse HEAD)"
_fixture_git -C "$sandbox/w" reset -q --hard HEAD~1

# A branch on origin with no upstream set still needs a force-push, and the
# hint names the remote and branch, which a plain push would lack
_fixture_git -C "$sandbox/w" push -q --force origin feat
_fixture_git -C "$sandbox/w" branch -q --unset-upstream
resign_out="$(TESTCWD="$sandbox/w" _isolated 'gresign' 2>&1)"
expect "gresign says a branch on origin with no upstream needs a force-push" 1 \
  "$(print -r -- "$resign_out" | grep -c 'origin/feat has the unsigned commits: force-push with git push --force-with-lease origin feat')"

# A branch that is on no remote needs no force-push
_fixture_git -C "$sandbox/w" checkout -q -b local-only
_fixture_git -C "$sandbox/w" rebase -q --force-rebase --no-gpg-sign origin/main
resign_out="$(TESTCWD="$sandbox/w" _isolated 'gresign' 2>&1)"
expect "gresign signs a branch that is on no remote" 0 "$?"
expect "gresign says nothing of a force-push for a branch on no remote" 0 \
  "$(print -r -- "$resign_out" | grep -c 'force-push')"
_fixture_git -C "$sandbox/w" checkout -q feat

# main moves on after the feature branched: the commits are re-signed in place
# on the branch's own base, not replayed onto the new tip of main
local resign_base
resign_base="$(git -C "$sandbox/w" merge-base HEAD origin/main)"
_fixture_git -C "$sandbox/w" rebase -q --force-rebase --no-gpg-sign "$resign_base"
_fixture_git -C "$sandbox/w" checkout -q main
print main > "$sandbox/w/g"
_fixture_git -C "$sandbox/w" add g
_fixture_git -C "$sandbox/w" -c commit.gpgsign=false commit -qm C5
_fixture_git -C "$sandbox/w" push -q origin main
_fixture_git -C "$sandbox/w" checkout -q feat
before="$(_gresign_view --format='%T %s|%b' "$resign_base..HEAD")"
resign_out="$(TESTCWD="$sandbox/w" _isolated 'gresign' 2>&1)"
expect "gresign signs a branch whose base branch has moved on" 'G G G' \
  "$(git -C "$sandbox/w" log --reverse --format=%G? "$resign_base..HEAD" | tr '\n' ' ' | sed 's/ $//')"
expect "gresign keeps the branch on its base when the base branch has moved on" \
  "$resign_base" "$(git -C "$sandbox/w" merge-base HEAD origin/main)"
expect "gresign keeps each tree when the base branch has moved on" "$before" \
  "$(_gresign_view --format='%T %s|%b' "$resign_base..HEAD")"

# Fixups fold into their targets as they are re-signed. These runs drop the
# ambient git config too, and GIT_EDITOR=false turns an editor that should not
# open into a failure rather than a hang. The branch is C2 C3 C4 here.
_gresign_bare() {  # $1 = snippet; gresign's combined output
  GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_EDITOR=false \
    TESTCWD="$sandbox/w" _isolated "$1" 2>&1
}
_gresign_subjects() {  # subjects after the branch base, oldest first
  git -C "$sandbox/w" log --reverse --format=%s "$resign_base..HEAD" | tr '\n' '|'
}
local resign_c2 resign_c3 resign_tree
resign_c2="$(git -C "$sandbox/w" rev-parse HEAD~2)"
resign_c3="$(git -C "$sandbox/w" rev-parse HEAD~1)"

# fixup!: folds into its target, which gains the change
print fix > "$sandbox/w/h"
_fixture_git -C "$sandbox/w" add h
_fixture_git -C "$sandbox/w" -c commit.gpgsign=false commit -q --fixup "$resign_c3"
resign_tree="$(git -C "$sandbox/w" rev-parse 'HEAD^{tree}')"
resign_out="$(_gresign_bare 'gresign')"
expect "gresign folds a fixup! commit" 0 "$?"
expect "gresign leaves the target in place of a folded fixup!" 'C2|C3|C4|' "$(_gresign_subjects)"
expect "gresign puts a fixup!'s change in its target" fix \
  "$(git -C "$sandbox/w" show HEAD~1:h 2>/dev/null)"
expect "gresign keeps the branch's final tree when folding" "$resign_tree" \
  "$(git -C "$sandbox/w" rev-parse 'HEAD^{tree}')"
expect "gresign signs the commits it folds into" 'G G G' \
  "$(git -C "$sandbox/w" log --reverse --format=%G? "$resign_base..HEAD" | tr '\n' ' ' | sed 's/ $//')"
expect "gresign counts the commits after folding, and the fixups folded" 1 \
  "$(print -r -- "$resign_out" | grep -c 'Signed 3 commits after .* (1 fixup folded)')"

# amend!: replaces its target's message with its own body
_fixture_git -C "$sandbox/w" -c commit.gpgsign=false commit -q --allow-empty \
  -m 'amend! C2' -m 'C2 reworded'
resign_out="$(_gresign_bare 'gresign')"
expect "gresign folds an amend! commit" 0 "$?"
expect "gresign rewords the target of an amend!" 'C2 reworded|C3|C4|' "$(_gresign_subjects)"

# --no-squash: the fixup stays a commit of its own, signed, and a ref after
# the flag still sets the boundary
print more >> "$sandbox/w/h"
_fixture_git -C "$sandbox/w" add h
_fixture_git -C "$sandbox/w" -c commit.gpgsign=false commit -q --fixup HEAD~1
resign_out="$(_gresign_bare 'gresign --no-squash HEAD~2')"
expect "gresign --no-squash <ref> succeeds" 0 "$?"
expect "gresign --no-squash keeps the fixup! commit" 'C2 reworded|C3|C4|fixup! C3|' \
  "$(_gresign_subjects)"
expect "gresign --no-squash <ref> signs only the commits after ref" 1 \
  "$(print -r -- "$resign_out" | grep -c 'Signed 2 commits after HEAD~2$')"
expect "gresign --no-squash signs the fixup! commit" G \
  "$(git -C "$sandbox/w" log -1 --format=%G?)"
_fixture_git -C "$sandbox/w" reset -q --hard HEAD~1

# A fixup that conflicts with its target stops the rebase and says how to go on
print 1 2 three | tr ' ' '\n' > "$sandbox/w/f"
_fixture_git -C "$sandbox/w" -c commit.gpgsign=false commit -q -a --fixup "$resign_c2"
head_before="$(git -C "$sandbox/w" rev-parse HEAD)"
resign_out="$(_gresign_bare 'gresign')"
expect "gresign fails on a conflicting fixup" 1 "$?"
expect "gresign explains a stopped rebase" 1 \
  "$(print -r -- "$resign_out" | grep -c 'gresign: the rebase stopped.*git rebase --continue.*git rebase --abort')"
expect "gresign leaves the conflicting rebase in progress" yes \
  "$([[ -d "$(git -C "$sandbox/w" rev-parse --absolute-git-dir)/rebase-merge" ]] && print yes)"
_fixture_git -C "$sandbox/w" rebase --abort
expect "aborting gresign's stopped rebase restores the branch" "$head_before" \
  "$(git -C "$sandbox/w" rev-parse HEAD)"
_fixture_git -C "$sandbox/w" reset -q --hard HEAD~1

expect "gresign leaves no globals behind" '' \
  "$(TESTCWD="$sandbox/w" _leak_diff 'gresign')"
rm -rf "$sandbox" "$setup_log"

# gdu, gdus and gcfuh say so when there is nothing to complete. As in the fixup
# probe, the stub prints only raw (-r) messages: without a message format
# style, those are the only ones zsh shows.
local changes_probe='
  fpath=("${fdir:h}/completions" $fpath)
  autoload -Uz _gdu _gdus _gcfuh
  _arguments() { _gcfuh_changed_files }
  _message() { [[ "$1" == -r ]] && print -r -- "message: $2" }'
sandbox="$(mktemp -d)" setup_log="$(mktemp)"
_fixture_git init -q -b main "$sandbox/w"
_fixture_git -C "$sandbox/w" -c user.name=t -c user.email=t@t commit -q --allow-empty -m C1
local changes_completion changes_message
for changes_completion changes_message in \
    _gdu 'no unstaged changes' \
    _gdus 'no staged changes' \
    _gcfuh 'no staged or unstaged changes'; do
  expect "${changes_completion#_} says so when there are no changes" \
    "message: $changes_message" \
    "$(TESTCWD="$sandbox/w" _isolated "$changes_probe; $changes_completion")"
done
rm -rf "$sandbox" "$setup_log"

local history_styles history_context style_out
history_styles="$(grep -E "^zstyle ':(completion|fzf-tab):" "$repo/omz/zshrc")"
for history_context in gciaf:argument-1 gcif:argument-1 ghist:argument-1 git_tag_semver:argument-3; do
  style_out="$(_isolated "$history_styles"'
    local value
    zstyle -s ":completion::complete:$1:commits" sort value
    print -r -- "$value"
  ' "$history_context")"
  expect "$history_context disables completion sorting" 'false' "$style_out"
  style_out="$(_isolated "$history_styles"'
    local -a flags
    zstyle -a ":fzf-tab:complete:$1" fzf-flags flags
    print -rl -- "${flags[@]}"
  ' "$history_context")"
  expect "$history_context disables fuzzy-score sorting" '--no-sort' "$style_out"
done
for history_context in git-show:argument-1 git_tag_semver:argument-1; do
  style_out="$(_isolated "$history_styles"'
    if zstyle -s ":completion::complete:$1" sort value ||
       zstyle -a ":fzf-tab:complete:$1" fzf-flags flags; then
      print -r -- overridden
    else
      print -r -- unchanged
    fi
  ' "$history_context")"
  expect "$history_context keeps non-history completion behavior" 'unchanged' "$style_out"
done

# zshrc chooses the editor from what is installed: Minimal mode has no nvim,
# and a Rebuild of a Dev container with a Home volume leaves only vi. Start an
# interactive zsh on the real zshrc, in a scratch home whose oh-my-zsh is an
# empty stub, with only stub editors on PATH, and ask Git which editor it opens.
# Run outside the checkout and without global config, so neither can set one.
local editor_home="$scratch/editor-home" editor_bin="$scratch/editor-bin" editor_stub
mkdir -p "$editor_home/.oh-my-zsh" "$editor_bin"/{nvim-vim,vim,none}
: > "$editor_home/.oh-my-zsh/oh-my-zsh.sh"
ln -s "$repo/omz/zshrc" "$editor_home/.zshrc"
for editor_stub in nvim-vim/nvim nvim-vim/vim vim/vim; do
  print -r -- '#!/bin/sh' > "$editor_bin/$editor_stub"
  chmod +x "$editor_bin/$editor_stub"
done
_zshrc_git_editor() {  # _zshrc_git_editor <editor-bin subdirectory> [NAME=value...]
  ( cd -- "$scratch" &&
    env -i HOME="$editor_home" USER=test TERM=xterm-256color PATH="$editor_bin/$1" \
      GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_BIN="${commands[git]}" \
      "${@:2}" "${commands[zsh]}" -d -i -c '"$GIT_BIN" var GIT_EDITOR' 2>/dev/null )
}
local ssh='SSH_CONNECTION=192.0.2.1 50000 192.0.2.2 22'
expect "zshrc opens nvim when it is installed" 'nvim' "$(_zshrc_git_editor nvim-vim)"
expect "zshrc opens vim over SSH even when nvim is installed" 'vim' "$(_zshrc_git_editor nvim-vim "$ssh")"
expect "zshrc opens vim when nvim is not installed" 'vim' "$(_zshrc_git_editor vim)"
expect "zshrc opens vi when neither nvim nor vim is installed" 'vi' "$(_zshrc_git_editor none)"

# checkout_reminder.zsh: zshrc sources it at shell start. The fixture is a home
# directory whose ~/.zshrc links into a Checkout cloned from a local upstream,
# with the Installer's record of that Checkout's commit and Install mode.
sandbox="$(mktemp -d)" setup_log="$(mktemp)"
local reminder="$repo/omz/checkout_reminder.zsh"
local home="$sandbox/home"
local checkout="$home/dotfiles" state_dir="$home/.local/state/dotfiles"
(
  export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
  set -e
  git init -q --bare -b main "$sandbox/up.git"
  git init -q -b main "$sandbox/seed"
  cd "$sandbox/seed" || exit 1
  git config user.email t@t; git config user.name t; git config commit.gpgsign false
  mkdir omz; print zshrc > omz/zshrc; git add -A; git commit -qm C1
  git push -q "$sandbox/up.git" main
  git clone -q "$sandbox/up.git" "$checkout"
  ln -s "$checkout/omz/zshrc" "$home/.zshrc"
  mkdir -p "$state_dir"
  : > "$state_dir/last-fetch"     # fetched just now, so nothing fetches by default
) >"$setup_log" 2>&1 || {
  fail "checkout_reminder fixture setup failed"
  sed 's/^/       /' "$setup_log"
}

_record_install() {  # _record_install <commit> <mode>
  print -rl -- "commit=$1" "mode=$2" > "$state_dir/installed"
}
_in_fixture_home() {  # _in_fixture_home <command...>: run it with the fixture home as HOME
  HOME="$home" XDG_STATE_HOME="$home/.local/state" "$@"
}
_start_shell() {  # stdout and stderr of sourcing the reminder in the fixture home
  _in_fixture_home _isolated 'source "$1"' "$reminder" 2>&1
}

# origin's default branch moved on, and an earlier fetch brought it in
_record_install "$(git -C "$checkout" rev-parse HEAD)" minimal
_fixture_git -C "$sandbox/seed" commit -q --allow-empty -m C2
_fixture_git -C "$sandbox/seed" push -q "$sandbox/up.git" main
_fixture_git -C "$checkout" fetch -q origin
expect "checkout_reminder: a Checkout behind origin prints the pull-and-install command" \
  'dotfiles: ~/dotfiles is behind origin/main. Update with: cd ~/dotfiles && git pull && ./install.sh' \
  "$(_start_shell)"

# pulled, but the Installer has not run since
_fixture_git -C "$checkout" merge -q --ff-only origin/main
expect "checkout_reminder: a Checkout moved since the Installer ran prints the install command" \
  'dotfiles: ~/dotfiles has changed since install.sh last ran. Apply with: cd ~/dotfiles && ./install.sh' \
  "$(_start_shell)"
_record_install "$(git -C "$checkout" rev-parse HEAD~1)" full
expect "checkout_reminder: the install command keeps Full mode" \
  'dotfiles: ~/dotfiles has changed since install.sh last ran. Apply with: cd ~/dotfiles && ./install.sh full' \
  "$(_start_shell)"

# behind origin and moved since the Installer ran, but on a topic branch
_fixture_git -C "$sandbox/seed" commit -q --allow-empty -m C3
_fixture_git -C "$sandbox/seed" push -q "$sandbox/up.git" main
_fixture_git -C "$checkout" fetch -q origin
_fixture_git -C "$checkout" checkout -q -b topic
expect "checkout_reminder: a Checkout on another branch prints nothing" '' "$(_start_shell)"
_fixture_git -C "$checkout" checkout -q --detach
expect "checkout_reminder: a detached Checkout prints nothing" '' "$(_start_shell)"
_fixture_git -C "$checkout" checkout -q main

# pulled and installed: nothing to say, and nothing left behind in the shell
_fixture_git -C "$checkout" merge -q --ff-only origin/main
_record_install "$(git -C "$checkout" rev-parse HEAD)" full
expect "checkout_reminder: a current Checkout writes nothing to stdout or stderr" '' "$(_start_shell)"
expect "checkout_reminder: leaves no globals behind" '' \
  "$(_in_fixture_home _leak_diff 'source "${fdir:h}/checkout_reminder.zsh"')"

# a machine whose Installer predates the record
_fixture_git -C "$sandbox/seed" commit -q --allow-empty -m C4
_fixture_git -C "$sandbox/seed" push -q "$sandbox/up.git" main
_fixture_git -C "$checkout" pull -q --ff-only
rm -f "$state_dir/installed"
expect "checkout_reminder: prints nothing when the Installer recorded nothing" '' "$(_start_shell)"

# a shell started from a git hook or editor, which inherits git's GIT_DIR
_record_install "$(git -C "$checkout" rev-parse HEAD~1)" full
expect "checkout_reminder: looks at the Checkout, not an inherited GIT_DIR" \
  'dotfiles: ~/dotfiles has changed since install.sh last ran. Apply with: cd ~/dotfiles && ./install.sh full' \
  "$(GIT_DIR="$sandbox/seed/.git" _start_shell)"
_record_install "$(git -C "$checkout" rev-parse HEAD)" full

# The fetch: a stub git whose fetch fails loudly after a slow network round trip
local stub_dir="$sandbox/stub" fetch_log="$sandbox/fetches"
mkdir -p "$stub_dir"; : > "$fetch_log"
cat > "$stub_dir/git" <<STUB
#!/bin/sh
case " \$* " in
  *" fetch "*)
    echo started >> "$fetch_log"
    echo "fatal: unable to access origin" >&2
    sleep 2
    echo finished >> "$fetch_log"
    exit 128 ;;
esac
exec "${commands[git]}" "\$@"
STUB
chmod +x "$stub_dir/git"
_await_fetches() {  # _await_fetches <n>: give n fetches up to 3s to start
  local -i tries
  for (( tries = 0; tries < 30; tries++ )); do
    (( $(grep -c started "$fetch_log") >= $1 )) && return
    sleep 0.1
  done
}

touch -d '25 hours ago' "$state_dir/last-fetch"
out="$(PATH="$stub_dir:$PATH" _start_shell)"
expect "checkout_reminder: startup does not wait for the fetch" 0 "$(grep -c finished "$fetch_log")"
expect "checkout_reminder: a failed fetch prints nothing" '' "$out"
_await_fetches 1
expect "checkout_reminder: fetches when the last fetch was a day ago" 1 "$(grep -c started "$fetch_log")"
PATH="$stub_dir:$PATH" _start_shell >/dev/null
sleep 0.5
expect "checkout_reminder: fetches at most once a day" 1 "$(grep -c started "$fetch_log")"
touch -d '25 hours ago' "$state_dir/last-fetch"
PATH="$stub_dir:$PATH" _start_shell >/dev/null
_await_fetches 2
expect "checkout_reminder: fetches again the next day" 2 "$(grep -c started "$fetch_log")"
rm -rf "$sandbox" "$setup_log"

(( failures == unit_failures )) && pass "all unit checks passed"

rm -rf -- "$scratch"

# --- verdict -----------------------------------------------------------------
print ""
if (( failures )); then
  print -r -- "🔴 zsh_function_test: $failures failure(s)"
  exit 1
fi
print -r -- "✅ zsh_function_test: all checks passed"
