#!/usr/bin/env bash
# File generated by pre-commit: https://pre-commit.com
# ID: 138fd403232d2ddd5efb44317e38bf03
#
# Edited after pre-commit generated it: when pre-commit is missing, the hook
# exits 0 for a repo with no .pre-commit-config.yaml at its top level, so only
# repos that use pre-commit need it installed. Regenerating this file with
# `pre-commit init-templatedir` drops that edit.

# start templated
ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=prepare-commit-msg --skip-on-missing-config)
# end templated

HERE="$(cd "$(dirname "$0")" && pwd)"
ARGS+=(--hook-dir "$HERE" -- "$@")

if command -v pre-commit > /dev/null; then
    exec pre-commit "${ARGS[@]}"
elif ! top="$(git rev-parse --show-toplevel 2>/dev/null)" ||
    [ ! -f "${top}/.pre-commit-config.yaml" ]; then
    exit 0
else
    echo '`pre-commit` not found.  Did you forget to activate your virtualenv?' 1>&2
    exit 1
fi
