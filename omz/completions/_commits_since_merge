#autoload

# Shared helper function to show the commits gcfuh may fixup: feature branch
# commits, or on the default branch the commits since the newest tag
# Used by git fixup-related completions (gciaf, gcif)
function _commits_since_merge() {
  if git rev-parse --git-dir >/dev/null 2>&1; then
    local -a commits
    local merge_base
    local log_output
    local line
    local boundary_name

    # Same scope boundary as gcfuh; empty means the whole history is in scope
    merge_base=$(_gcfuh_base)

    # If a boundary was found, show commits since then; otherwise show recent commits
    if [[ -n "$merge_base" ]]; then
      log_output=$(git log --oneline --no-decorate --grep='^fixup! ' --invert-grep "$merge_base"..HEAD 2>/dev/null)
    else
      log_output=$(git log --oneline --no-decorate --grep='^fixup! ' --invert-grep -n 25 2>/dev/null)
    fi

    # NF skips the blank line an empty log leaves, which would otherwise
    # become a bare ":" candidate
    commits=()
    while IFS= read -r line; do
      [[ -n "$line" ]] && commits+=("$line")
    done < <(printf '%s\n' "$log_output" | awk 'NF {print $1":"substr($0, index($0,$2))}')

    if [[ ${#commits[@]} -gt 0 ]]; then
      _describe -V -t commits 'commits' commits
    else
      # An empty scope is deliberate (released history stays put), so name the
      # boundary rather than offer nothing. -r shows the message even when no
      # format style is set, which is the case in this config.
      boundary_name=$(_gcfuh_base -n)
      _message -r "no commits ${boundary_name:+after $boundary_name }to fix up"
      return 1
    fi
  fi
}

_commits_since_merge "$@"
