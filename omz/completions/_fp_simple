#compdef fpa fpsa fps fprm fprmi fpst fprestart

# Shared completion for the podman fzf helpers that take no flags beyond
# -h/--help plus an optional freeform fzf query: fpa, fpsa, fps, fprm,
# fprmi, fpst, fprestart.
function _fp_simple() {
  _arguments -s -S \
    '(-h --help)'{-h,--help}'[Show help]' \
    '*:query:'
}
