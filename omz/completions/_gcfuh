#compdef gcfuh

# Completion for the "gcfuh" (git commit fixup helper) command.
# Completes files with staged or unstaged changes.
function _gcfuh_changed_files() {
  if git rev-parse --git-dir >/dev/null 2>&1; then
    local -a files
    local line changed_file

    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      changed_file="${line:3}"

      # For renames, complete the destination path.
      if [[ "$changed_file" == *" -> "* ]]; then
        changed_file="${changed_file##* -> }"
      fi

      files+=("$changed_file")
    done <<< "$(git status --short --untracked-files=all 2>/dev/null)"

    typeset -U files
    if [[ ${#files[@]} -eq 0 ]]; then
      _message 'no staged or unstaged changes'
      return 1
    fi

    _describe -V -t files 'changed files' files
  fi
}

# Tags first: on the default branch the boundary is usually a release.
function _gcfuh_refs() {
  local -a refs

  if git rev-parse --git-dir >/dev/null 2>&1; then
    refs=(${(f)"$(git for-each-ref --sort=-creatordate --format='%(refname:short):tag' refs/tags 2>/dev/null)"})
    refs+=(${(f)"$(git for-each-ref --format='%(refname:short):branch' refs/heads refs/remotes 2>/dev/null)"})
  fi

  _describe -V -t refs 'boundary ref' refs
}

function _gcfuh() {
  _arguments -s -S \
    '(-h --help)'{-h,--help}'[Show help message]' \
    '(-a --auto)'{-a,--auto}'[Assign every change to a commit without prompting]' \
    '(-b --base)-b[Scope boundary: only commits after it can be targets]:boundary ref:_gcfuh_refs' \
    '(-b --base)--base=[Scope boundary: only commits after it can be targets]:boundary ref:_gcfuh_refs' \
    '*:file:_gcfuh_changed_files'
}

_gcfuh "$@"
