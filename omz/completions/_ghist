#compdef ghist

# Completion for ghist - git history with pretty formatting
_ghist() {
  local -a opts

  # Common -N options
  opts=(
    '-05:last 5 commits'
    '-10:last 10 commits'
    '-15:last 15 commits'
    '-20:last 20 commits'
    '-25:last 25 commits'
  )

  # Add HEAD~N for commits on branch. With none pending, ghist shows the recent
  # history instead, so offer HEAD through HEAD~9. Completion never fetches: it
  # uses the cached refs.
  local base_branch
  base_branch=$(git_find_branch_base -n)

  local -a history_cmd
  if [[ -n $base_branch ]] &&
     (( $(git rev-list --count --cherry-pick --right-only "${base_branch}...HEAD" 2>/dev/null) == 0 )); then
    history_cmd=(git log --oneline --no-decorate --first-parent -n 10 HEAD)
  else
    history_cmd=(git log --oneline --no-decorate "${base_branch:-HEAD~25}..HEAD")
  fi

  local i=0
  while IFS= read -r line; do
    local hash=${line%% *}
    local msg=${line#* }
    [[ $i -eq 0 ]] && opts+=("HEAD:${msg:0:50} ($hash)") || opts+=("HEAD~${i}:${msg:0:50} ($hash)")
    ((i++))
  done < <("${history_cmd[@]}" 2>/dev/null)

  _describe -V -t commits 'commits' opts
}

_ghist "$@"
