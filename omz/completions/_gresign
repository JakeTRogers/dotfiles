#compdef gresign

# Completion for "gresign" - sign the commits after a ref that need it.
function _gresign() {
  local -a refs

  if git rev-parse --git-dir >/dev/null 2>&1; then
    refs=(${(f)"$(git for-each-ref --format='%(refname:short):branch' refs/heads refs/remotes 2>/dev/null)"})
    refs+=(${(f)"$(git for-each-ref --format='%(refname:short):tag' refs/tags 2>/dev/null)"})
  fi

  _arguments -s -S \
    '--no-squash[sign only; keep fixup!, squash! and amend! commits unfolded]' \
    '1:boundary:(($refs))'
}
