#######################################
# _gcfuh_blame_target - suggest fixup targets by blaming changed lines
#
# Blames the lines a file's unstaged changes actually touch (the old side of
# each diff hunk) against HEAD, and returns every in-scope commit among the
# results, newest first. This is more precise than "the file's last commit"
# when a file spans several branch commits, and more than one line means the
# changes belong to more than one commit. Pure additions and new/untracked
# files yield nothing (there are no committed lines to blame).
#
# Usage:
#   targets=$(_gcfuh_blame_target path/to/file "$merge_boundary")
#   suggestion=${targets%%$'\n'*}     # just the newest
#
# Arguments:
#   $1  File path (must exist in HEAD)
#   $2  Scope boundary commit (output of _gcfuh_base); empty means the whole
#       history is in scope, root commit included
# Returns:
#   One "<short-hash> <subject>" line per commit the changed lines blame to,
#   newest first, or nothing
#######################################
emulate -L zsh

# [[ =~ ]] writes its capture variables into the enclosing scope unless
# they are declared local first. This function reads $match.
local MATCH MBEGIN MEND
local -a match mbegin mend
local file=$1 merge_boundary=$2
[[ -n "$file" ]] || return 0

local range=HEAD
[[ -n "$merge_boundary" ]] && range="${merge_boundary}..HEAD"

# Only tracked files have committed lines to blame
git cat-file -e "HEAD:$file" 2>/dev/null || return 0

# In-scope commits newest first, excluding autosquash commits, so blame
# results can be both filtered to the scope and reported in order.
local -a order=()
local -A in_scope=() blamed=()
local full_hash
while IFS= read -r full_hash; do
  [[ -n "$full_hash" ]] && order+=("$full_hash") && in_scope[$full_hash]=1
done < <(git log --format='%H' --grep='^fixup! ' --grep='^squash! ' --grep='^amend! ' --invert-grep "$range" 2>/dev/null)
[[ ${#order[@]} -eq 0 ]] && return 0

# Walk the diff and record the HEAD line numbers that are actually removed or
# modified (lines starting with '-'), tracking the old-side line counter.
# Context and added lines are skipped so we never blame unrelated lines.
local -a removed=()
local line hunk in_hunk=0 old_lineno=0
while IFS= read -r line; do
  if [[ "$line" == @@* ]]; then
    hunk="${line#@@ -}"; hunk="${hunk%% +*}"   # "oldStart[,oldCount]"
    old_lineno="${hunk%%,*}"
    in_hunk=1
    continue
  fi
  (( in_hunk )) || continue
  case "$line" in
    '\'*) ;;                                       # "\ No newline at end of file"
    +*) ;;                                         # added line: no old counterpart
    -*) removed+=($old_lineno); old_lineno=$((old_lineno + 1)) ;;
    *)  old_lineno=$((old_lineno + 1)) ;;          # context line
  esac
done < <(git diff --no-ext-diff -- "$file" 2>/dev/null)
[[ ${#removed[@]} -eq 0 ]] && return 0             # pure additions: nothing to blame

# Group the removed line numbers (already ascending) into contiguous ranges
local -a ranges=()
local ln run_start=-1 run_prev=-1
for ln in "${removed[@]}"; do
  if (( run_start < 0 )); then run_start=$ln; run_prev=$ln
  elif (( ln == run_prev + 1 )); then run_prev=$ln
  else ranges+=("${run_start},${run_prev}"); run_start=$ln; run_prev=$ln
  fi
done
(( run_start >= 0 )) && ranges+=("${run_start},${run_prev}")

# Blame each range in HEAD; collect every in-scope commit touched.
local r bline
for r in "${ranges[@]}"; do
  while IFS= read -r bline; do
    [[ "$bline" =~ '^([0-9a-f]{40}) ' ]] || continue
    [[ -n "${in_scope[$match[1]]}" ]] && blamed[$match[1]]=1
  done < <(git blame -L "$r" --porcelain HEAD -- "$file" 2>/dev/null)
done
[[ ${#blamed[@]} -eq 0 ]] && return 0

for full_hash in "${order[@]}"; do
  [[ -n "${blamed[$full_hash]}" ]] && git log -1 --format='%h %s' "$full_hash" 2>/dev/null
done
return 0
