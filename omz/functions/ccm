#######################################
# ccm - Generate a Conventional Commit message from staged changes via Copilot
#######################################

emulate -L zsh
setopt localoptions localtraps

local model="gpt-5.4-mini"
local reasoning_effort=""
local show_help=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_help=1
      shift
      ;;
    -m|--model)
      if [[ $# -lt 2 ]]; then
        pprint "🔴 $1 requires a model argument." "$fgRed" >&2
        return 1
      fi
      model="$2"
      shift 2
      ;;
    --model=)
      pprint "🔴 --model requires a non-empty value." "$fgRed" >&2
      return 1
      ;;
    --model=?*)
      model="${1#*=}"
      shift
      ;;
    -r|--reasoning-effort)
      if [[ $# -lt 2 ]]; then
        pprint "🔴 $1 requires a reasoning effort argument." "$fgRed" >&2
        return 1
      fi
      reasoning_effort="$2"
      shift 2
      ;;
    --reasoning-effort=)
      reasoning_effort=""
      shift
      ;;
    --reasoning-effort=?*)
      reasoning_effort="${1#*=}"
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      pprint "🔴 unknown argument: $1" "$fgRed" >&2
      return 1
      ;;
  esac
done

if [[ $# -gt 0 ]]; then
  pprint "🔴 unexpected argument: $1" "$fgRed" >&2
  return 1
fi

if [[ -z "${model//[[:space:]]/}" ]]; then
  pprint "🔴 --model requires a non-empty value." "$fgRed" >&2
  return 1
fi

if [[ -z "${reasoning_effort//[[:space:]]/}" ]]; then
  reasoning_effort=""
fi

if (( show_help )); then
  fold -w "$(tput cols)" -s <<'EOF'
Usage: ccm [OPTIONS]
Generate a Conventional Commit message from the currently staged changes using Copilot,
then open git commit with the generated message.

Options:
  -m, --model <MODEL>                      Model to use for generation. Default: gpt-5.4-mini
  -r, --reasoning-effort <EFFORT>         Optional reasoning effort for supported models.
  -h, --help                              Show this help

Requirements:
  - copilot CLI in PATH
  - current directory inside a git repository
  - at least one staged change

Examples:
  ccm
  ccm --model gpt-5.4
  ccm --model o4-mini --reasoning-effort high
EOF
  return 0
fi

# Dependency and state checks
if ! command -v copilot >/dev/null 2>&1; then
  pprint "🔴 copilot CLI is not installed or not in PATH." "$fgRed" >&2
  return 1
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  pprint "🔴 not inside a Git repository." "$fgRed" >&2
  return 1
fi

if git diff --cached --quiet; then
  pprint "🔴 no staged changes." "$fgRed" >&2
  return 1
fi

# Local variables
local repo_root=""
local context=""
local prompt=""
local message=""
local reason=""
local msg_file=""
local edited_msg_file=""
local commit_status=0
local -a copilot_args=()

repo_root="$(git rev-parse --show-toplevel)" || {
  pprint "🔴 failed to determine the repository root." "$fgRed" >&2
  return 1
}

pprint "📝 Collecting staged context..." "$fgBlue"
if ! context="$(
  printf '=== REPO ROOT ===\n'
  printf '%s\n\n' "$repo_root"

  printf '=== GIT STATUS ===\n'
  git status
  printf '\n'

  printf '=== STAGED STAT ===\n'
  git diff --cached --stat
  printf '\n'

  printf '=== STAGED FILES ===\n'
  git diff --cached --name-status
  printf '\n'

  # fails in a repository without commits; continue without history
  printf '=== RECENT SUBJECTS ===\n'
  git log --no-merges --format=%s -30 --author="$(git config user.name)" --invert-grep --grep='^bump:' 2>/dev/null || true
  printf '\n'

  printf '=== STAGED DIFF ===\n'
  git diff --cached
)"; then
  pprint "🔴 failed to collect staged context." "$fgRed" >&2
  return 1
fi

prompt=$(cat <<EOF
You **MUST** use the conventional-commit skill.

Create a Conventional Commit message for the staged changes.

Use the skill's raw mode: output only the complete commit message as plain text, with no markdown fences, labels, notes, or commentary. If you cannot draft a message, output exactly one line: NO_COMMIT_MESSAGE: <short reason>.
The Git context is provided below. Do not run commands. You may read repository files to clarify intent, but describe only changes that appear in the staged diff.
Do not modify files.

$context
EOF
)

pprint "🤖 Asking Copilot for a commit message..." "$fgBlue"
copilot_args=(
  copilot
  -p "$prompt"
  -s
  --model "$model"
  --no-ask-user
  --add-dir "$repo_root"
)

if [[ -n "$reasoning_effort" ]]; then
  copilot_args+=(--reasoning-effort "$reasoning_effort")
fi

if ! message="$("${copilot_args[@]}")"; then
  pprint "🔴 Copilot failed to generate a commit message." "$fgRed" >&2
  return 1
fi

message="${message#"${message%%[![:space:]]*}"}"
message="${message%"${message##*[![:space:]]}"}"

# the prompt asks for raw mode, but strip a fenced block in case the model
# answers in chat mode anyway
if [[ $message == *\`\`\`*$'\n'*$'\n'\`\`\`* ]]; then
  message="${message#*\`\`\`}"       # drop any preface and the opening fence marker
  message="${message#*$'\n'}"        # drop the rest of the opening fence line, e.g. "text"
  message="${message%$'\n'\`\`\`*}"  # drop the closing fence and anything after it
fi

message="${message#"${message%%[![:space:]]*}"}"
message="${message%"${message##*[![:space:]]}"}"

if [[ "$message" == NO_COMMIT_MESSAGE* ]]; then
  reason="${${message%%$'\n'*}#NO_COMMIT_MESSAGE}"
  reason="${reason#:}"
  reason="${reason#"${reason%%[![:space:]]*}"}"
  pprint "🔴 Copilot did not draft a commit message: ${reason:-no reason given}" "$fgRed" >&2
  return 1
fi

if [[ -z "$message" || "$message" == \`\`\`* ]]; then
  pprint "🔴 Copilot did not return a usable commit message." "$fgRed" >&2
  return 1
fi

msg_file="$(mktemp "${TMPDIR:-/tmp}/copilot-commit-msg.XXXXXX")" || {
  pprint "🔴 failed to create a temporary commit message file." "$fgRed" >&2
  return 1
}

trap '[[ -n "$msg_file" ]] && rm -f -- "$msg_file"; return 130' INT

printf '%s\n' "$message" > "$msg_file"

pprint "🔵 Opening git commit editor..." "$fgBlue"
git commit -S -e -F "$msg_file"
commit_status=$?

# a failed hook or signature aborts the commit; keep the generated message so
# a retry does not need a new, different one from Copilot
if (( commit_status != 0 )); then
  edited_msg_file="$(git rev-parse --path-format=absolute --git-path COMMIT_EDITMSG 2>/dev/null)"
  pprint "🔴 git commit failed; the generated message is kept in $msg_file" "$fgRed" >&2
  pprint "Run 'git commit -S -e -F $msg_file' to retry." "$fgYellow" >&2
  pprint "If the editor opened, your edits are in ${edited_msg_file:-.git/COMMIT_EDITMSG}" "$fgYellow" >&2
  return $commit_status
fi

rm -f -- "$msg_file"

return 0
