#######################################
# fpl - View logs from podman containers
#
# Interactive selection of containers with fzf (supports multiselect),
# then displays logs. Supports following logs and specifying number of lines.
#
# Arguments:
#   -f, --follow          Follow log output
#   -n, --lines LINES     Number of lines to show (default: all)
#   query                 Optional fzf search query
#
# Outputs:
#   Interactive fzf selection, then displays container logs
#######################################

emulate -L zsh
if _fp_wants_help "$@"; then
  _fp_command_help fpl
  return 0
fi

_check_podman || return 1

local -a opt_f opt_n
zparseopts -D -E f=opt_f -follow=opt_f n:=opt_n -lines:=opt_n

local lines="${opt_n[2]}"
local -a log_args
local -a containers

log_args=(logs --color)
(( ${#opt_f} )) && log_args+=(-f)
[[ -n "$lines" ]] && log_args+=(--tail "$lines")

local query="$1"

containers=("${(@f)$(_fp_pick --source ps-a --binds reload,inspect,stats,rm --multi --query "$query")}")
# A cancelled picker yields one empty element, not an empty array; drop it so
# the guard below does not hand podman an empty container argument.
containers=("${(@)containers:#}")

if (( ${#containers[@]} > 0 )); then
  log_args+=("${containers[@]}")
  podman "${log_args[@]}"
fi
