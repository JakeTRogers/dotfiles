#######################################
# git_find_branch_base - Find base branch name or merge base commit
#
# Asks origin/HEAD which branch is the default, and only falls back to guessing
# from main/master/develop/development/production when the remote does not say.
# By default, returns the merge base commit hash.
# With -n or --name, returns the branch name instead.
#
# For each candidate the remote-tracking ref is tried before the local branch:
# a local trunk that has not been fetched in a while yields an older merge base,
# which makes callers like gcfuh and ghist treat already-merged commits as being
# on the current branch.
#
# Usage:
#   local base_commit base_branch
#   base_commit=$(git_find_branch_base)
#   base_branch=$(git_find_branch_base -n)   # e.g. "origin/main" or "main"
#
# Arguments:
#   -n, --name    Return branch name instead of commit hash
#
# Globals:
#   None
# Returns:
#   Merge base commit hash (default) or branch name, or empty string if not found
#######################################

emulate -L zsh
local return_name=0
local merge_base base_branch branch default_branch
local -a candidates

# Parse arguments
if [[ "$1" == "-n" || "$1" == "--name" ]]; then
  return_name=1
fi

# The branch origin/HEAD points at is the repository's own answer to "what is
# the default branch", so it is tried before the hardcoded guesses.
default_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
[[ -n "$default_branch" ]] && candidates+=("${default_branch#origin/}")
candidates+=(main master develop development production)
candidates=("${(@u)candidates}")   # (u) keeps the first occurrence of each

# base_branch is assigned only once a merge base is actually found, so a
# candidate that exists but shares no history cannot leave a stale name behind.
for branch in "${candidates[@]}"; do
  if git show-ref --verify --quiet "refs/remotes/origin/$branch" 2>/dev/null; then
    merge_base=$(git merge-base HEAD "origin/$branch" 2>/dev/null)
    if [[ -n "$merge_base" ]]; then
      base_branch="origin/$branch"
      break
    fi
  fi
  if git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
    merge_base=$(git merge-base HEAD "$branch" 2>/dev/null)
    if [[ -n "$merge_base" ]]; then
      base_branch="$branch"
      break
    fi
  fi
done

# If no merge base found with standard branches, fall back to initial commit
if [[ -z "$merge_base" ]]; then
  merge_base=$(git rev-list --max-parents=0 HEAD 2>/dev/null | head -1)
fi

# Return based on flag
if [[ $return_name -eq 1 ]]; then
  echo "$base_branch"
else
  echo "$merge_base"
fi
