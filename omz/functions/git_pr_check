#######################################
# git_pr_check - Check sub-directories for pull requests
#######################################

emulate -L zsh
if [[ $1 == "--help" || $1 == "-h" ]]; then
  fold -w "$(tput cols)" -s <<'EOF'
Usage: git_pr_check [directory]
Check sub-directories for pull requests.

Arguments:
  directory  The directory to check. Defaults to the current directory.
EOF
  return 0
fi

local dir
for dir in "${1:-.}"/*(/N); do
  # Ask git rather than looking for a .git directory: worktrees and submodules
  # keep a .git *file*, and bare repos have neither.
  if ! git -C "$dir" rev-parse --git-dir &>/dev/null; then
    pprint "➖ $dir, not a git repo"
    continue
  fi

  if ! git -C "$dir" remote -v | grep -iq github; then
    pprint "⚠️  ${dir}, not using GitHub" "$fgYellow"
    continue
  fi

  echo
  pprint "✅ ${dir}" "$fgGreen"
  # gh resolves the repository from its working directory and has no -C, so it
  # needs a cd. Do it in a subshell: a bare cd would strand the interactive
  # shell in a subdirectory if the loop were interrupted partway through.
  ( cd "$dir" && gh pr list )
  echo
done
