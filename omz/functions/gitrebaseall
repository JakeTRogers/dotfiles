#######################################
# gitrebaseall - ⚠ Rebase every local branch onto the default branch and force-push each
# Arguments:
#   -n, --dry-run  List the branches that would be rebased, then stop
#   -y, --yes      Skip the confirmation prompt
#   -h, --help     Show help
# Outputs:
#   Progress for each branch, then the resulting branch list
# Returns:
#   0 on success, 1 on failure or if the user declined
#######################################

emulate -L zsh

# [[ =~ ]] writes its capture variables into the enclosing scope unless
# they are declared local first.
local MATCH MBEGIN MEND
if [[ $1 == "--help" || $1 == "-h" ]]; then
  fold -w "$(tput cols)" -s <<'EOF'
Usage: gitrebaseall [--dry-run] [--yes]
Rebase every local branch onto the repository's default branch, then force-push each one to origin.

⚠ Every branch is pushed with --force. Anything a colleague pushed to one of these branches and you have not fetched is overwritten. Intended for branches only you work on.

The default branch comes from origin/HEAD when the remote advertises one, and otherwise from the first of main, master, development, production, or develop that exists locally. Those trunk branches are never themselves rebased.

Branches are listed for confirmation before anything is rebased. If a rebase fails, the rebase is aborted, the default branch is checked out, and the run stops so nothing further is pushed.

Options:
  -n, --dry-run  List the branches that would be rebased and force-pushed, then stop
  -y, --yes      Skip the confirmation prompt
  -h, --help     Show this help

Examples:
  See which branches would be rewritten
    gitrebaseall --dry-run
  Rebase and force-push everything without being asked
    gitrebaseall --yes
EOF
  return 0
fi

git rev-parse --git-dir &>/dev/null || {
  pprint "🔴 gitrebaseall: not a git repository" "$fgRed" >&2
  return 1
}

local arg branch response def_branch start_branch
local dry_run=0
local assume_yes=0

for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) dry_run=1 ;;
    -y|--yes)     assume_yes=1 ;;
    # The guard above only sees $1, so catch --help in any other position too
    -h|--help)    gitrebaseall --help; return 0 ;;
    *)
      pprint "🔴 gitrebaseall: unknown argument: $arg" "$fgRed" >&2
      pprint "Run 'gitrebaseall --help' for usage." "$fgYellow" >&2
      return 1
      ;;
  esac
done

# Rebasing rewrites the working tree, so refuse to start with uncommitted work
if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
  pprint "🔴 gitrebaseall: working tree is not clean; commit or stash first." "$fgRed" >&2
  return 1
fi

# One shared answer to "what is the default branch": git_find_branch_base asks
# origin/HEAD first and falls back to the conventional names. It may return the
# remote-tracking ref, but this function checks the branch out, so strip the
# remote prefix and require the local branch below.
def_branch=$(git_find_branch_base -n)
def_branch=${def_branch#origin/}

if [[ -z "$def_branch" ]]; then
  pprint "🔴 gitrebaseall: could not determine the default branch." "$fgRed" >&2
  return 1
fi

if ! git show-ref --verify --quiet "refs/heads/$def_branch"; then
  pprint "🔴 gitrebaseall: default branch '$def_branch' does not exist locally." "$fgRed" >&2
  return 1
fi

start_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# Every local branch except the trunks. The trunk names are excluded by name,
# not just $def_branch, so a repo that keeps both main and production does not
# rebase one onto the other.
local -a branches
branches=("${(@f)$(git for-each-ref --format='%(refname:short)' refs/heads/)}")
branches=("${(@)branches:#}")
branches=("${(@)branches:#(main|master|development|production|develop)}")

if (( ${#branches} == 0 )); then
  pprint "🔵 No branches to rebase; only trunk branches exist." "$fgBlue"
  return 0
fi

pprint "These branches will be rebased onto '${def_branch}' and force-pushed to origin:" "$fgCyan" "$txBold"
echo
for branch in "${branches[@]}"; do
  printf '  %-30s %s\n' "$branch" "$(git log -1 --format='%h %s' "$branch" 2>/dev/null)"
done
echo
pprint "⚠ Each branch is pushed with --force, overwriting whatever origin holds." "$fgYellow"
echo

if (( dry_run )); then
  pprint "🔵 Dry run: nothing was rebased or pushed." "$fgBlue"
  return 0
fi

if (( ! assume_yes )); then
  printf '%b' "${fgYellow}Proceed? [y/N]:${txReset} "
  read -r response
  if [[ ! "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    pprint "⚠️  Aborted." "$fgYellow"
    return 1
  fi
  echo
fi

for branch in "${branches[@]}"; do
  pprint "🔄 Rebasing ${branch}..." "$fgBlue"
  if git checkout "$branch" && git rebase "$def_branch" && git push origin "$branch" --force; then
    pprint "  ✅ ${branch}" "$fgGreen"
  else
    pprint "  🔴 Failed on ${branch}" "$fgRed" >&2
    git rebase --abort 2>/dev/null
    git checkout "${start_branch:-$def_branch}"
    return 1
  fi
  echo
done

git checkout "$def_branch"
git branch -v
