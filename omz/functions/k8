#######################################
# k8 - Cluster triage queries: broken pods, nodes, ingress, finalizers
#######################################

emulate -L zsh

if [[ $# -eq 0 || $1 == "--help" || $1 == "-h" ]]; then
  fold -w "${COLUMNS:-$(tput cols)}" -s <<'EOF'
Usage: k8 <subcommand> [-n NAMESPACE] [--context CONTEXT]
Read-only triage queries against a Kubernetes cluster. Everything is formatted
as a table; nothing here modifies the cluster.

Subcommands:
  bad          Pods that are neither Running nor Succeeded
  events       FailedScheduling events, oldest first (why pods are unschedulable)
  exposed      Services published as LoadBalancer or NodePort
  flapping     Containers with a restart count above zero, including init containers
  ingress      Ingress hosts, plus Traefik IngressRoute hosts when the CRD exists
  nodes        Nodes that are not Ready, with the reason
  finalizers   Resources carrying finalizers, which can block deletion
  top cpu      Pods by CPU usage
  top mem      Pods by memory usage

Options:
  -n, --namespace NS    Limit to one namespace. Default: all namespaces.
                        Ignored by "nodes", which is cluster-scoped.
  --context CONTEXT     kubectl context to use. Default: the current context.
  -h, --help            Show this help

Examples:
  Everything unhealthy in the cluster
    k8 bad
  Why nothing will schedule in one namespace
    k8 events -n payments
  Containers that keep dying, on another cluster
    k8 flapping --context sandbox
  Biggest memory consumers
    k8 top mem
EOF
  return 0
fi

local tool
for tool in kubectl jq; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    pprint "🔴 k8: $tool is required, but not found." "$fgRed" >&2
    return 1
  fi
done

local subcommand="$1"
shift

local namespace="" context=""
local -a rest
while (( $# )); do
  case "$1" in
    -n|--namespace)
      if [[ -z "${2:-}" ]]; then
        pprint "🔴 k8: --namespace requires a value" "$fgRed" >&2
        return 1
      fi
      namespace="$2"; shift 2 ;;
    --namespace=*) namespace="${1#*=}"; shift ;;
    --context)
      if [[ -z "${2:-}" ]]; then
        pprint "🔴 k8: --context requires a value" "$fgRed" >&2
        return 1
      fi
      context="$2"; shift 2 ;;
    --context=*) context="${1#*=}"; shift ;;
    -h|--help) k8 --help; return 0 ;;
    -*)
      pprint "🔴 k8: unknown option: $1" "$fgRed" >&2
      return 1 ;;
    *) rest+=("$1"); shift ;;
  esac
done

local -a kubectl_cmd=(kubectl)
[[ -n "$context" ]] && kubectl_cmd+=(--context "$context")

# Namespace scope, shared by every namespaced query
local -a scope
if [[ -n "$namespace" ]]; then
  scope=(-n "$namespace")
else
  scope=(--all-namespaces)
fi

case "$subcommand" in
  bad)
    "${kubectl_cmd[@]}" get pods "${scope[@]}" \
      --field-selector='status.phase!=Running,status.phase!=Succeeded'
    ;;

  events)
    "${kubectl_cmd[@]}" get events "${scope[@]}" \
      --field-selector=reason=FailedScheduling \
      --sort-by=.metadata.creationTimestamp
    ;;

  exposed)
    # Selected on .spec.type rather than by column position: the old k8ext alias
    # tested awk field $4, which is CLUSTER-IP in `get svc -A` output, not TYPE.
    "${kubectl_cmd[@]}" get svc "${scope[@]}" -o json | jq -r '
      ["NAMESPACE","NAME","TYPE","EXTERNAL-IP","PORTS"],
      ( .items[]
        | select(.spec.type == "LoadBalancer" or .spec.type == "NodePort")
        | [ .metadata.namespace,
            .metadata.name,
            .spec.type,
            ( [ (.status.loadBalancer.ingress // [])[] | (.ip // .hostname) ]
              | if length == 0 then "-" else join(",") end ),
            ( [ (.spec.ports // [])[]
                | "\(.port)\(if .nodePort then ":\(.nodePort)" else "" end)/\(.protocol // "TCP")" ]
              | join(",") )
          ]
      ) | @tsv' | column -t
    ;;

  flapping)
    "${kubectl_cmd[@]}" get pods "${scope[@]}" -o json | jq -r '
      ["NAMESPACE","POD","CONTAINER","RESTARTS","REASON"],
      ( .items[]
        | .metadata.namespace as $ns
        | .metadata.name as $pod
        | ( (.status.containerStatuses // []) + (.status.initContainerStatuses // []) )[]
        | select((.restartCount // 0) > 0)
        | [ $ns, $pod, .name,
            ((.restartCount // 0) | tostring),
            (.lastState.terminated.reason // .state.waiting.reason // "-")
          ]
      ) | @tsv' | column -t
    ;;

  ingress)
    "${kubectl_cmd[@]}" get ingress "${scope[@]}" -o json | jq -r '
      ["NAMESPACE","NAME","CLASS","HOSTS"],
      ( .items[]
        | [ .metadata.namespace,
            .metadata.name,
            (.spec.ingressClassName // .metadata.annotations["kubernetes.io/ingress.class"] // "-"),
            ( [ (.spec.rules // [])[] | .host // empty ]
              | if length == 0 then "-" else join(",") end )
          ]
      ) | @tsv' | column -t

    # Traefik IngressRoute is a CRD; only report it where it is installed.
    if "${kubectl_cmd[@]}" get ingressroute "${scope[@]}" -o json >/dev/null 2>&1; then
      echo
      "${kubectl_cmd[@]}" get ingressroute "${scope[@]}" -o json | jq -r '
        ["NAMESPACE","INGRESSROUTE","HOSTS"],
        ( .items[]
          | [ .metadata.namespace,
              .metadata.name,
              ( [ (.spec.routes // [])[] | .match // "" ]
                | join(" || ")
                | gsub("`"; "")
                | [ scan("Host\\(([^)]*)\\)") ]
                | flatten
                | if length == 0 then "-" else join(",") end )
            ]
        ) | @tsv' | column -t
    fi
    ;;

  nodes)
    # Cluster-scoped, so the namespace scope deliberately does not apply
    "${kubectl_cmd[@]}" get nodes -o json | jq -r '
      ["NODE","CONDITION","STATUS","REASON"],
      ( .items[]
        | .metadata.name as $node
        | .status.conditions[]
        | select(.type == "Ready" and .status != "True")
        | [ $node, .type, .status, (.reason // "-") ]
      ) | @tsv' | column -t
    ;;

  finalizers)
    "${kubectl_cmd[@]}" get all "${scope[@]}" -o json | jq -r '
      ["KIND","NAMESPACE","NAME","FINALIZERS"],
      ( .items[]
        | select(.metadata.finalizers != null)
        | [ .kind,
            (.metadata.namespace // "-"),
            .metadata.name,
            (.metadata.finalizers | join(","))
          ]
      ) | @tsv' | column -t
    ;;

  top)
    local metric="${rest[1]}"
    case "$metric" in
      cpu)        "${kubectl_cmd[@]}" top pods "${scope[@]}" --sort-by=cpu ;;
      mem|memory) "${kubectl_cmd[@]}" top pods "${scope[@]}" --sort-by=memory ;;
      *)
        pprint "🔴 k8 top: expected 'cpu' or 'mem', got: ${metric:-(nothing)}" "$fgRed" >&2
        return 1 ;;
    esac
    ;;

  *)
    pprint "🔴 k8: unknown subcommand: $subcommand" "$fgRed" >&2
    pprint "Run 'k8 --help' for the list." "$fgYellow" >&2
    return 1
    ;;
esac
