# Pins for the patched gitstatusd; see README.md. Plain sh assignments:
# build.sh reads the source pins and omz/configure.sh reads the release pins.

# Source: the gitstatus commit that powerlevel10k bundles. Its build.info pins
# the libgit2 fork commit that relativeworktrees.patch applies to.
gitstatus_repo='https://github.com/romkatv/gitstatus.git'
gitstatus_commit='039ac1b02698f2ebb3fe17d2c800b2aecc0245c8'

# Release: what the Configure step installs. Set both after the gitstatusd
# workflow publishes a release; release_sha256 is in its .sha256 asset.
release_repo='JakeTRogers/dotfiles'
release_tag=''
release_sha256=''
